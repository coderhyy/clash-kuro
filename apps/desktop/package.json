{
  "name": "@kuro/desktop",
  "productName": "Clash Kuro",
  "private": true,
  "version": "0.0.1",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "node scripts/fetch-core.mjs && electron-vite build && electron-builder --mac --dir",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "fetch-core": "node scripts/fetch-core.mjs",
    "icons": "electron scripts/make-icons.mjs",
    "package:win": "node scripts/fetch-core.mjs win32-x64 && electron-vite build && electron-builder --win --dir"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@tailwindcss/vite": "4.3.3",
    "@kuro/api": "workspace:*",
    "@kuro/core": "workspace:*",
    "@kuro/state": "workspace:*",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  }
}
